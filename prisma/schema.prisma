generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    String?
  signature String? @db.Text
  expansionSettings Json? // Stores settings for all expansions { "core-signature": { ... } }
  emails    Email[]
  labels    Label[]
  rules     Rule[]
  accounts  Account[]
  moltSessions MoltSession[]
  pushSubscriptions PushSubscription[]
  calendars Calendar[]
  calendarEvents CalendarEvent[]
  contacts Contact[]
  appointmentSchedules AppointmentSchedule[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Email {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId   String       @unique
  from        String
  to          String
  cc          String?
  bcc         String?
  replyTo     String?
  subject     String?
  snippet     String?
  htmlKey     String?
  textKey     String?
  rawKey      String?
  createdAt   DateTime     @default(now())
  read        Boolean      @default(false)
  folder      String       @default("inbox")
  status      String       @default("received")
  starred     Boolean      @default(false)
  cleanTo     String?
  scheduledAt DateTime?
  smartReplies Json?
  attachmentsChecked Boolean @default(false)
  rawMimeUrl  String?      // Resend raw MIME download URL for async attachment processing
  // Carpeta de origen al mover a archive/trash/spam (aditivo: ADD COLUMN IF NOT EXISTS "previousFolder" TEXT). La fija el servidor.
  previousFolder     String?
  // Hilos de conversacion (aditivo: ADD COLUMN IF NOT EXISTS, ver src/lib/db/schema.ts y src/lib/threading.ts). Se escriben con SQL crudo tolerante.
  rfcMessageId String?   // Message-ID (sin <>, dominio en minusculas)
  inReplyTo   String?    // Message-ID del padre directo
  refs        String?    // References normalizadas separadas por espacio (raiz + 50 mas recientes)
  threadKey   String?    // raiz canonica del hilo: m:<Message-ID> | e:<id> | h:<clave heuristica heredada>
  attachments Attachment[]
  events      EmailEvent[]
  labels      Label[]      @relation("EmailToLabel")

  @@index([to])
  @@index([folder])
  @@index([createdAt])
  @@index([userId])
  @@index([userId, folder, createdAt(sort: Desc)])
  @@index([userId, folder, read])
  @@index([userId, scheduledAt])
  @@index([userId, threadKey])
  @@index([userId, rfcMessageId])
}

model Attachment {
  id        String   @id @default(cuid())
  emailId   String?
  filename  String
  mimeType  String
  size      Int
  key       String
  status    String   @default("ready")  // "pending" | "ready" | "failed"
  createdAt DateTime @default(now())
  draftId   String?
  // Content-ID (sin angulos) de imagenes inline: resuelve `cid:` antes que el filename. Aditivo (ADD COLUMN IF NOT EXISTS "contentId" TEXT).
  contentId String?
  draft     Draft?   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  email     Email?   @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([draftId])
}

model EmailEvent {
  id            String   @id @default(cuid())
  emailId       String?
  resendEmailId String?
  type          String
  data          Json?
  createdAt     DateTime @default(now())
  email         Email?   @relation(fields: [emailId], references: [id])

  @@index([resendEmailId])
  @@index([type])
  @@index([emailId])
}

model Draft {
  id          String       @id @default(cuid())
  to          String?
  subject     String?
  body        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  from        String
  bcc         String?
  cc          String?
  // Contexto de respuesta (aditivo: ADD COLUMN IF NOT EXISTS; se escribe con SQL crudo tolerante en api/drafts)
  inReplyToEmailId String?
  replyMode        String?
  attachments Attachment[]

  @@index([updatedAt])
  @@index([from])
}

model Label {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#6366f1")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliasSuffix String?
  filterRegex String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  emails      Email[]  @relation("EmailToLabel")

  // Columnas ADITIVAS creadas por src/lib/db/schema.ts y leidas/escritas por SQL crudo (src/lib/labels/store.ts), a proposito
  // fuera de este modelo para que los findMany existentes no dependan de ellas: parentId TEXT (padre, mismo modelo, sin ciclos,
  // profundidad <= 5), behavior TEXT ('tag'|'folder'), sortOrder INT, icon TEXT, showInSidebar BOOL, showUnread BOOL,
  // fullPath TEXT (ruta calculada "Trabajo/Proyecto A"; NULL = name).
  // "name" es el SEGMENTO. La unicidad es (userId, COALESCE(parentId,''), name): indice "Label_user_parent_name_key" (no expresable en Prisma).
  @@index([userId])
}

model Rule {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  enabled        Boolean  @default(true)
  priority       Int      @default(0)
  conditions     Json     @default("{}")
  actions        Json     @default("[]")
  stopProcessing Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Columnas aditivas por SQL crudo (src/lib/rules/store.ts): labelId TEXT (regla de "Asignar automaticamente" de una etiqueta),
  // matchedCount INT, lastMatchedAt TIMESTAMPTZ. Tablas RuleBatch / RuleBatchItem: lotes de "Aplicar a existentes" con deshacer.
  @@index([userId, priority])
}

// Correos ya procesados por el motor de reglas (idempotencia). Se usa via SQL crudo.
model RuleRun {
  emailId   String   @id
  userId    String
  appliedAt DateTime @default(now())

  @@index([userId])
}

model MoltSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accessToken   String   @unique // The token MoltBot sends with requests
  refreshToken  String?  // Used to rotate access tokens
  expiresAt     DateTime // When the access token expires
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([accessToken])
}

model PushSubscription {
  id             String   @id
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime BigInt?  @map("expiration_time")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lastSuccessAt  DateTime? @map("last_success_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model PushVapidConfig {
  id         String   @id
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  subject    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("push_vapid_config")
}

model Calendar {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String          @default("#2563eb")
  source       String          @default("local")
  isReadOnly   Boolean         @default(false)
  externalId   String?
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  events       CalendarEvent[]

  @@unique([userId, source, name])
  @@index([userId])
  @@index([source])
}

model CalendarEvent {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId     String
  calendar       Calendar          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title          String
  description    String?           @db.Text
  location       String?
  startsAt       DateTime
  endsAt         DateTime
  allDay         Boolean           @default(false)
  status         String            @default("confirmed")
  responseStatus String?
  source         String            @default("local")
  externalId     String?
  inviteUid      String?
  organizerEmail String?
  organizerName  String?
  sourceEmailId  String?
  // Conferencia adjunta (opcional; el enlace tambien sigue en location por compatibilidad con eventos existentes)
  conferenceUrl       String?
  conferenceProvider  String?
  conferenceMeetingId String?
  lastSyncedAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  attendees      CalendarAttendee[]

  @@index([userId])
  @@index([calendarId])
  @@index([startsAt])
  @@index([source])
  @@index([inviteUid])
  @@index([userId, startsAt])
  @@index([calendarId, externalId])
}

model CalendarAttendee {
  id             String        @id @default(cuid())
  eventId        String
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  responseStatus String?
  isOrganizer    Boolean       @default(false)
  invitedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([eventId])
  @@index([email])
}

model Contact {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  source     String   @default("local")
  externalId String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, email])
  @@index([userId])
  @@index([source])
}

model AppointmentSchedule {
  id           String                    @id @default(cuid())
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?                   @db.Text
  duration     Int                       @default(30)
  color        String                    @default("#2563eb")
  timezone     String                    @default("UTC")
  isActive     Boolean                   @default(true)
  conferencing String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  availability AppointmentAvailability[]
  bookings     AppointmentBooking[]

  @@index([userId])
}

model AppointmentAvailability {
  id         String              @id @default(cuid())
  scheduleId String
  schedule   AppointmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  String
  endTime    String
  isEnabled  Boolean             @default(true)

  @@index([scheduleId])
}

model AppointmentBooking {
  id              String              @id @default(cuid())
  scheduleId      String
  schedule        AppointmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  calendarEventId String?
  guestName       String
  guestEmail      String
  guestNotes      String?             @db.Text
  startsAt        DateTime
  endsAt          DateTime
  meetUrl         String?
  status          String              @default("confirmed")
  cancelToken     String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([scheduleId])
  @@index([startsAt])
  @@index([guestEmail])
  @@index([cancelToken])
}

// ---------------------------------------------------------------------------
// Seguridad (ADITIVO, NO ejecutado). Estas tablas se usan por SQL crudo (lib/audit.ts, lib/mfa.ts,
// lib/session-revocation.ts) y su DDL vive en src/lib/db/schema.ts (ensure-schema). Se declaran aqui solo para
// mantener schema.prisma y schema.ts sincronizados (prisma/rule.md); sin relaciones para no alterar los modelos existentes.
// Tampoco se declara User.tokenVersion (INTEGER NOT NULL DEFAULT 0) a proposito: si estuviera en el modelo, TODA consulta
// a User fallaria en un despliegue donde el DDL aun no se aplico.
// ---------------------------------------------------------------------------
model AuditEvent {
  id     String   @id
  ts     DateTime @default(now())
  event  String
  userId String?
  ip     String?
  data   Json     @default("{}")

  @@index([ts])
  @@index([userId, ts])
  @@index([event, ts])
}

// Sandbox de extensiones (services.storage / services.notify). SIN relaciones (como AuditEvent): acceso por SQL crudo.
// La FK a User con ON DELETE CASCADE vive solo en el DDL (src/lib/db/schema.ts).
model ExtensionStorage {
  userId      String
  extensionId String
  key         String
  value       String   @db.Text // JSON serializado
  bytes       Int
  updatedAt   DateTime @default(now())

  @@id([userId, extensionId, key])
}

model ExtensionNotification {
  id          String    @id
  userId      String
  extensionId String
  level       String    @default("info")
  title       String?
  message     String    @db.Text
  url         String?
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([createdAt])
}

model UserMfa {
  userId         String    @id
  secretEnc      String    @db.Text // AES-256-GCM (encryption.ts v3)
  enabled        Boolean   @default(false)
  lastStep       BigInt    @default(0) // ultimo paso TOTP aceptado (anti-replay)
  recoveryHashes Json      @default("[]") // HMAC-SHA256 de los codigos de recuperacion vigentes
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  updatedAt      DateTime  @default(now())
}

model RevokedSession {
  jti       String   @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

// Consola de administracion (ADITIVO, NO ejecutado; DDL en src/lib/db/schema.ts, acceso por SQL crudo en src/lib/admin/*).
model UserAdminState {
  userId             String    @id
  disabled           Boolean   @default(false)
  disabledAt         DateTime?
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  updatedAt          DateTime  @default(now())

  @@index([lastLoginAt])
}

model UserSession {
  jti       String   @id
  userId    String
  tv        Int      @default(0)
  mfa       Boolean  @default(false)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

// Spam v2 (src/lib/spam/*). Tablas ADITIVAS creadas por db/schema.ts (DDL IF NOT EXISTS); el codigo las usa por SQL crudo tolerante.
// Las columnas Email.spamScore (INTEGER), Email.spamReasons (JSONB) e Email.isExternal (BOOLEAN) tampoco figuran en el modelo Email a proposito.
model SpamList {
  id                String    @id
  scope             String    // 'domain' | 'user'
  ownerKey          String    // 'domain' o el id del usuario
  kind              String    // 'allow' | 'block' | 'external'
  matchType         String    // 'email' | 'domain' | 'wildcard' | 'tld' | 'regex'
  value             String
  includeSubdomains Boolean   @default(false)
  reason            String?
  expiresAt         DateTime?
  createdBy         String?
  hits              Int       @default(0)
  lastHitAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([scope, ownerKey, kind, matchType, value, includeSubdomains], map: "SpamList_unique_idx")
  @@index([scope, ownerKey, kind, createdAt(sort: Desc)], map: "SpamList_owner_kind_idx")
}

model SpamToken {
  userId    String
  tokenHash String
  spam      Int      @default(0)
  ham       Int      @default(0)
  updatedAt DateTime @default(now())

  @@id([userId, tokenHash])
  @@index([userId, updatedAt(sort: Desc)], map: "SpamToken_user_updated_idx")
}

model SpamSender {
  userId    String
  senderKey String
  spamCount Int      @default(0)
  hamCount  Int      @default(0)
  updatedAt DateTime @default(now())

  @@id([userId, senderKey])
}

model SpamEvent {
  id           String   @id
  ts           DateTime @default(now())
  userId       String?
  recipient    String?
  sender       String
  senderDomain String?
  decision     String
  score        Int?
  ruleId       String?
  ruleLabel    String?
  reasons      Json     @default("[]")
  external     Boolean  @default(false)

  @@index([ts(sort: Desc)], map: "SpamEvent_ts_idx")
  @@index([decision, ts(sort: Desc)], map: "SpamEvent_decision_ts_idx")
  @@index([senderDomain, ts(sort: Desc)], map: "SpamEvent_domain_ts_idx")
}

model AdminSetting {
  key       String   @id
  value     Json     @default("null")
  updatedAt DateTime @default(now())
  updatedBy String?
}

// Registro de reuniones creadas por la fachada de conferencias (src/lib/conferencing). Sirve para: (1) idempotencia
// persistente (Idempotency-Key => misma reunion, tambien con varias instancias serverless), (2) PROPIEDAD: solo el
// usuario que creo una reunion puede borrarla/actualizarla (en modo instancia el token del proveedor es de toda la cuenta).
model ConferenceMeeting {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  meetingId      String
  joinUrl        String   @db.Text
  hostUrl        String?  @db.Text
  idempotencyKey String?
  status         String   @default("ready") // pending | ready | deleted
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, provider, idempotencyKey])
  @@index([userId, provider, meetingId])
  @@index([createdAt])
}

// Importar / exportar correo (ADITIVO; DDL con IF NOT EXISTS en src/lib/db/schema.ts, acceso por SQL crudo en src/lib/mail-transfer/*).
// "userId" es el administrador que lanza el trabajo (o el propio usuario en "Mi buzon"); sin FK porque un "manager" del backend no es un User.
model MailTransferJob {
  id              String             @id
  userId          String
  actorKind       String             @default("user")
  domain          String             @default("")
  kind            String // import | export
  scope           String             @default("domain") // domain | mailboxes | self
  targetUserId    String?
  format          String             @default("unknown")
  status          String             @default("created") // created|uploading|uploaded|analyzing|ready|queued|running|done|failed|canceled|expired
  phase           String             @default("")
  fileName        String?
  options         Json               @default("{}")
  summary         Json               @default("{}")
  cursor          Json               @default("{}")
  totalBytes      BigInt             @default(0)
  uploadedBytes   BigInt             @default(0)
  totalItems      Int                @default(0)
  doneItems       Int                @default(0)
  importedItems   Int                @default(0)
  duplicateItems  Int                @default(0)
  skippedItems    Int                @default(0)
  errorItems      Int                @default(0)
  bytesProcessed  BigInt             @default(0)
  outputBytes     BigInt             @default(0)
  outputSha256    String?
  lockedUntil     DateTime?
  lastError       String?
  cancelRequested Boolean            @default(false)
  downloadedAt    DateTime?
  expiresAt       DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now())
  items           MailTransferItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([domain, status])
  @@index([status, updatedAt])
}

model MailTransferItem {
  id        BigInt          @id @default(autoincrement())
  jobId     String
  mailbox   String          @default("")
  sourceKey String
  messageId String?
  status    String          @default("pending") // pending | imported | duplicate | skipped | error | done
  error     String?
  emailId   String?
  folder    String?
  bytes     BigInt          @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now())
  job       MailTransferJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourceKey])
  @@index([jobId, status])
}
