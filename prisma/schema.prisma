generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    String?
  signature String? @db.Text
  expansionSettings Json? // Stores settings for all expansions { "core-signature": { ... } }
  emails    Email[]
  labels    Label[]
  accounts  Account[]
  moltSessions MoltSession[]
  pushSubscriptions PushSubscription[]
  calendars Calendar[]
  calendarEvents CalendarEvent[]
  contacts Contact[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Email {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId   String       @unique
  from        String
  to          String
  subject     String?
  snippet     String?
  htmlKey     String?
  textKey     String?
  rawKey      String?
  createdAt   DateTime     @default(now())
  read        Boolean      @default(false)
  folder      String       @default("inbox")
  status      String       @default("received")
  starred     Boolean      @default(false)
  cleanTo     String?
  scheduledAt DateTime?
  smartReplies Json?
  attachments Attachment[]
  events      EmailEvent[]
  labels      Label[]      @relation("EmailToLabel")

  @@index([to])
  @@index([folder])
  @@index([createdAt])
  @@index([userId])
}

model Attachment {
  id        String   @id @default(cuid())
  emailId   String?
  filename  String
  mimeType  String
  size      Int
  key       String
  createdAt DateTime @default(now())
  draftId   String?
  draft     Draft?   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  email     Email?   @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model EmailEvent {
  id            String   @id @default(cuid())
  emailId       String?
  resendEmailId String?
  type          String
  data          Json?
  createdAt     DateTime @default(now())
  email         Email?   @relation(fields: [emailId], references: [id])

  @@index([resendEmailId])
  @@index([type])
}

model Draft {
  id          String       @id @default(cuid())
  to          String?
  subject     String?
  body        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  from        String
  bcc         String?
  cc          String?
  attachments Attachment[]

  @@index([updatedAt])
  @@index([from])
}

model Label {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#6366f1")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliasSuffix String?
  filterRegex String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  emails      Email[]  @relation("EmailToLabel")

  @@unique([userId, name])
  @@index([userId])
}

model MoltSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accessToken   String   @unique // The token MoltBot sends with requests
  refreshToken  String?  // Used to rotate access tokens
  expiresAt     DateTime // When the access token expires
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([accessToken])
}

model PushSubscription {
  id             String   @id
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime BigInt?  @map("expiration_time")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lastSuccessAt  DateTime? @map("last_success_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model PushVapidConfig {
  id         String   @id
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  subject    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("push_vapid_config")
}

model Calendar {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String          @default("#2563eb")
  source       String          @default("local")
  isReadOnly   Boolean         @default(false)
  externalId   String?
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  events       CalendarEvent[]

  @@unique([userId, source, name])
  @@index([userId])
  @@index([source])
}

model CalendarEvent {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId     String
  calendar       Calendar          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title          String
  description    String?           @db.Text
  location       String?
  startsAt       DateTime
  endsAt         DateTime
  allDay         Boolean           @default(false)
  status         String            @default("confirmed")
  responseStatus String?
  source         String            @default("local")
  externalId     String?
  inviteUid      String?
  organizerEmail String?
  organizerName  String?
  sourceEmailId  String?
  lastSyncedAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  attendees      CalendarAttendee[]

  @@index([userId])
  @@index([calendarId])
  @@index([startsAt])
  @@index([source])
  @@index([inviteUid])
}

model CalendarAttendee {
  id             String        @id @default(cuid())
  eventId        String
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  responseStatus String?
  isOrganizer    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([eventId])
  @@index([email])
}

model Contact {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  source     String   @default("local")
  externalId String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, email])
  @@index([userId])
  @@index([source])
}
