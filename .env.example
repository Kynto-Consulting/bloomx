# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bloomx"

# Session secret: OWNED BY THIS INSTANCE (required). Signs the session JWT; the internal server-to-server key, signed
# URLs, unsubscribe tokens and (as a fallback) encryption are derived from it. Never share it with the backend.
# Generate one with: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Public origin, needed to build the Google OAuth redirect URI (only if you enable Google)
NEXTAUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
TOP_DOMAIN="example.com" # Domain Bloomx should resolve locally and use for system mail like noreply@example.com

# AI (runs on the shared BACKEND; a single key for the chosen provider). See /docs/ai
AI_PROVIDER="openai" # openai | grok | cohere | anthropic | gemini (an invalid value breaks sign-up and storage)
AI_KEY="..."
# AI_MODEL="gpt-4o-mini"

# Storage (S3 / R2 / MinIO)
S3_ENDPOINT="https://..."
S3_REGION="auto"
S3_ACCESS_KEY="..."
S3_SECRET_KEY="..."
S3_BUCKET="bloomx-uploads"

# Email (Resend)
RESEND_API_KEY="re_..."
WEBHOOK_SECRET="whsec_..." # OPTIONAL (each organizer decides): with it a valid Resend/Svix signature is required on /api/webhooks/resend; without it the webhook is accepted unsigned
# RESEND_WEBHOOK_SECRET="whsec_..." # OPTIONAL: same rule for the bounce/complaint webhook /api/webhooks/resend-events

# Resend inbound webhook URL
# Register this endpoint in Resend when enabling inbound email and email event webhooks:
# https://your-public-host.example/api/webhooks/resend

# Registration
REGISTRATION_KEY="admin-secret-to-allow-signups"

# OAuth Providers (Expansions)

# Google (Drive, Meet, Calendar)
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# Zoom
ZOOM_CLIENT_ID="..."
ZOOM_CLIENT_SECRET="..."
# Reuniones (Zoom / Meet): las credenciales de la INSTANCIA (Zoom Server-to-Server, cuenta de servicio o cuenta organizadora de Google)
# se configuran en Ajustes > Integraciones, no aqui. Ver /docs/conferencing.
# Solo pruebas locales (se ignoran en produccion salvo hacia localhost): GOOGLE_API_BASE, MEET_API_BASE, GOOGLE_TOKEN_URL, ZOOM_API_BASE, ZOOM_OAUTH_BASE

# Slack
SLACK_CLIENT_ID="..."
SLACK_CLIENT_SECRET="..."

# Notion
NOTION_CLIENT_ID="..."
NOTION_CLIENT_SECRET="..."

# HubSpot
HUBSPOT_CLIENT_ID="..."
HUBSPOT_CLIENT_SECRET="..."

# Trello
TRELLO_API_KEY="..." # The Application Key (not user token)

# Web push (optional). If omitted, a VAPID pair is generated and stored in the push_vapid_config table.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Sending limits, Elixir and mail (all optional; defaults in parentheses)
# MAX_SENDS_PER_HOUR=200                # normal sends per hour per user
# ELIXIR_BATCH_MAX=50                   # rows per send request (cap 100)
# ELIXIR_MAX_ROWS_PER_HOUR=5000         # (MAX_BULK_ROWS is an old alias; it is PER HOUR, not per request)
# ELIXIR_MAX_CAMPAIGN_ROWS=20000
# UNSUBSCRIBE_SECRET=                   # default NEXTAUTH_SECRET
# APPOINTMENT_CANCEL_SECRET=            # default NEXTAUTH_SECRET
# SECURE_MESSAGE_ENABLED=true
# S3_SSE=AES256                         # or aws:kms: provider-side encryption

# Brand at build time (optional; /api/config from the backend normally provides the brand)
# BRAND_NAME=
# BRAND_COLOR=
# BRAND_LOGO=
# NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Lima

# Development only: company theme JSON that replaces the one from /api/config (ignored in production). See /docs/themes
# NEXT_PUBLIC_BLOOMX_THEME_OVERRIDE={"primaryColor":"#7c3aed","radius":"lg"}

NODE_ENV=development
NEXT_PUBLIC_BACKEND_URL="https://backend.bloomx.arubik.dev"


# ---------------------------------------------------------------------------
# Seguridad (ver informe de hardening). Todas opcionales salvo donde se indique.
# ---------------------------------------------------------------------------
# Sesion JWT: inactividad (renovacion deslizante) y tope absoluto desde el login
# SESSION_TTL_SECONDS=86400
# SESSION_ABSOLUTE_MAX_SECONDS=1209600
# Tokens anteriores al cambio (sin jti) caducan a las SESSION_TTL_SECONDS de su emision; false = rechazarlos ya
# SESSION_ALLOW_LEGACY_TOKENS=true
# SESSION_REVOCATION_CACHE_MS=5000
# Cookie de sesion: en produccion se escribe __Host-next-auth.session-token; se sigue LEYENDO la antigua (sin prefijo) hasta que
# las sesiones previas caduquen (max. 30 dias). Poner 0 pasado ese plazo.
# SESSION_COOKIE_LEGACY_READ=true
# SESSION_COOKIE_HOST_PREFIX=true

# MFA TOTP: administradores (emails separados por coma) => MFA obligatorio
# ADMIN_EMAILS=admin@tu-dominio.com
# MFA_ENFORCE_ADMIN=true
# MFA_REQUIRED_ALL=false
# MFA_ISSUER=Bloomx
# MFA_RECOVERY_PEPPER=          # por defecto NEXTAUTH_SECRET; fijalo si vas a rotar NEXTAUTH_SECRET

# Cifrado en reposo: clave dedicada (distinta de NEXTAUTH_SECRET) con id para rotacion
# DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_ID=k1
# DATA_ENCRYPTION_KEYS_PREVIOUS=k0:clave-anterior
# ENCRYPTION_REQUIRE_DEDICATED_KEY=false
# ENCRYPTION_WRITE_FORMAT=v3            # v2 = rollback al formato sin keyId
# ACCOUNT_TOKENS_LAZY_MIGRATE=true

# URLs firmadas de /api/assets
# ASSET_SIGNING_KEY=                    # por defecto derivada de NEXTAUTH_SECRET
# ASSET_URL_TTL_SECONDS=3600
# ASSET_UPLOAD_URL_TTL_SECONDS=2592000
# ASSET_UNSIGNED_INBOUND=owner          # allow | owner | deny
# ASSET_UNSIGNED_UPLOADS=allow          # allow | owner | deny (subir a owner/deny cuando caduquen los enlaces antiguos)

# Antivirus opcional (ClamAV REST) y validacion de adjuntos
# AV_SCAN_URL=
# AV_SCAN_TOKEN=
# AV_SCAN_FIELD=file
# AV_SCAN_TIMEOUT_MS=8000
# AV_SCAN_MAX_BYTES=26214400
# AV_FAIL_MODE=open                     # open | closed
# INBOUND_BLOCK_DANGEROUS_EXT=true

# Retencion (POST/GET /api/admin/retention, con CRON_SECRET o sesion admin)
# CRON_SECRET=
# RETENTION_SPAM_DAYS=30
# RETENTION_TRASH_DAYS=0
# RETENTION_RAW_DAYS=0
# RETENTION_BATCH=200
# AUDIT_RETENTION_DAYS=365
# AUDIT_DB=on                           # off = solo stdout
# SECURE_MESSAGE_TTL_DAYS=30

# Otros
# GOOGLE_ALLOW_SIGNUP=false             # en produccion, permitir crear cuentas nuevas via Google
# MOLT_SIGNING_KEY=                     # por defecto derivada de NEXTAUTH_SECRET

# --- Rate limit distribuido (Upstash Redis REST). Sin estas variables: memoria por instancia ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Si Redis falla: memory (defecto, cuenta en memoria) | open (deja pasar). Nunca bloquea a todos por una caida de Redis.
# RATE_LIMIT_ON_ERROR=memory
# RATE_LIMIT_REDIS_TIMEOUT_MS=800

# ---------------------------------------------------------------------------
# Backend COMPARTIDO (bloomx-backend): autenticacion SIN secretos compartidos
# ---------------------------------------------------------------------------
# NO hace falta configurar (ya no se usan entre frontend y backend, y este frontend tampoco los exige):
#   INTERNAL_SECRET, EXTENSION_HOOKS_SECRET, FRONTEND_INTERNAL_URL
#   - La clave interna servidor-a-servidor de ESTA instancia se DERIVA de NEXTAUTH_SECRET con HKDF-SHA256
#     (info "bloomx-internal-v1", src/lib/internal-auth.ts). INTERNAL_SECRET solo se acepta si lo defines (compat).
#   - NEXTAUTH_SECRET es propio de esta instancia: NO se comparte con el backend.
#
# OPCIONAL: clave privada Ed25519 de ESTA instancia (PEM PKCS8 o base64). Con ella los proxies frontend->backend
# (extension/execute, hooks, listado de handlers) FIRMAN cada peticion. Sin ella se usa el protocolo antiguo por cabeceras
# (modo LEGADO del backend: sin credenciales de dominio ni services.mail; el backend responde X-BloomX-Auth: legacy).
# Generar: node scripts/gen-domain-keypair.mjs   y registrar la clave PUBLICA en el backend (ver README).
# BLOOMX_DOMAIN_PRIVATE_KEY=
# OPCIONAL: clave publica Ed25519 del backend para verificar el puente services.mail (/api/internal/mail).
# Si se omite se descubre (con cache) en NEXT_PUBLIC_BACKEND_URL/.well-known/bloomx-backend-key.json. Fijarla es lo mas seguro.
# BLOOMX_BACKEND_PUBLIC_KEY=
# OPCIONAL: URL publica https de esta instancia (se envia firmada como origen de callback del puente de correo).
# NEXT_PUBLIC_APP_URL=https://mail.tu-dominio.com
