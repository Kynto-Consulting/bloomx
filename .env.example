# ===========================================================================
# BloomX frontend: .env minimo
# La marca, el dominio, el correo del administrador y la clave de Resend del
# dominio se configuran en /admin/register (ver README), NO aqui.
# ===========================================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/bloomx"

# --- Almacenamiento S3-compatible (adjuntos). Recomendado: Backblaze B2 (tiene capa gratuita), ver README ---
S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
S3_REGION="us-west-004"
S3_ACCESS_KEY="..."
S3_SECRET_KEY="..."
S3_BUCKET="bloomx-uploads"

# --- Propios de esta instancia ---
# Firma la sesion y de ella se derivan las claves internas. NO se comparte con el backend.
# Generar: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Backend compartido al que se conecta esta instancia
NEXT_PUBLIC_BACKEND_URL="https://backend.bloomx.arubik.dev"
# Dominio que Bloomx resuelve localmente y usa para correo de sistema (noreply@tu-dominio.com)
TOP_DOMAIN="example.com"

# --- Resend: el codigo del frontend AUN lee esta clave del entorno (envio, correo entrante, adjuntos).
# Es la misma que escribes en /admin/register. ---
RESEND_API_KEY="re_..."

# --- Registro de usuarios (/register). En produccion, si falta o vale "dev-secret", el registro responde 403 ---
REGISTRATION_KEY="admin-secret-to-allow-signups"

NODE_ENV=development


# ===========================================================================
# OPCIONAL. Todo lo de abajo esta comentado a proposito: descomenta solo lo que uses.
# Referencia completa y valores por defecto: /docs/env-variables
# ===========================================================================

# Administradores semilla/rescate (emails separados por coma, nivel 4, MFA obligatorio). Ver /docs/admin-cli
# ADMIN_EMAILS=admin@tu-dominio.com

# Firma de peticiones frontend -> backend (modo firmado, recomendado). Generar: node scripts/gen-domain-keypair.mjs
# y registrar la clave PUBLICA en el backend. Sin ella el dominio funciona en modo LEGADO (privilegios reducidos).
# BLOOMX_DOMAIN_PRIVATE_KEY=
# BLOOMX_BACKEND_PUBLIC_KEY=            # si se omite se descubre en NEXT_PUBLIC_BACKEND_URL/.well-known/bloomx-backend-key.json

# Webhooks de Resend: con secreto se exige firma Svix; sin el se aceptan sin firma (recomendado en produccion)
# WEBHOOK_SECRET=whsec_...              # /api/webhooks/resend
# RESEND_WEBHOOK_SECRET=whsec_...       # /api/webhooks/resend-events

# Cron (/api/cron/run, /api/cron/elixir, /api/admin/retention)
# CRON_SECRET=

# Login con Google / integraciones OAuth propias de la instancia (Zoom y Meet se configuran en Ajustes > Integraciones)
# NEXTAUTH_URL=http://localhost:3000     # solo si activas Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# TRELLO_API_KEY=                       # Application Key (no el token de usuario)

# Web push. Si se omite, se genera un par VAPID y se guarda en la tabla push_vapid_config
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Limites de envio / Elixir
# MAX_SENDS_PER_HOUR=200
# ELIXIR_BATCH_MAX=50
# ELIXIR_MAX_ROWS_PER_HOUR=5000
# ELIXIR_MAX_CAMPAIGN_ROWS=20000
# S3_SSE=AES256                         # o aws:kms

# Rate limit distribuido (Upstash Redis REST). Sin estas variables: memoria por instancia
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cifrado en reposo con clave dedicada (distinta de NEXTAUTH_SECRET) y rotacion
# DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_ID=k1

# Marca en build (normalmente la entrega /api/config del backend)
# BRAND_NAME=
# BRAND_COLOR=
# BRAND_LOGO=
# NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Lima

# Solo desarrollo: tema de empresa local que reemplaza al de /api/config. Ver /docs/themes
# NEXT_PUBLIC_BLOOMX_THEME_OVERRIDE={"primaryColor":"#7c3aed","radius":"lg"}

# "Entrar con Bloomx" para apps externas (docs/EXTERNAL-LOGIN.md). Sin clientes validos queda apagado.
# BLOOMX_EXTERNAL_CLIENTS=[{"clientId":"killio","name":"Killio","redirectUris":["https://backend.killio.dev/auth/social/bloomx/callback"]}]
